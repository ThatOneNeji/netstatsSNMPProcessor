                "datatype": "OCTETSTR",
                "columntype": "column",
                "order": "2",
                "description": "VRRP interface name",
                "status": "Current",
                "range": "0..255"
            }
        },
        {
            ".1.3.6.1.4.1.14988.1.1.25.1.1.3": {
                "name": "mtxrVrrpVrId",
                "datatype": "INTEGER32",
                "columntype": "column",
                "order": "3",
                "description": "Virtual router id (VRID)",
                "status": "Current",
                "range": "0..255"
            }
        },
        {
            ".1.3.6.1.4.1.14988.1.1.25.1.1.4": {
