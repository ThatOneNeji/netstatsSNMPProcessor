{
    "logger": {
        "appenders": {
            "out": {
                "type": "console"
            },
            "task": {
                "type": "file",
                "filename": "logs/server.log",
                "maxLogSize": 1048576,
                "backups": 20
            }
        },
        "categories": {
            "default": {
                "appenders": [
                    "out",
                    "task"
                ],
                "level": "debug"
            },
            "task": {
                "appenders": [
                    "task"
                ],
                "level": "error"
            }
        }
    },
    "logging": {
        "level": "debug",
        "areas": [
            "parser",
            "messagebroker",
            "messageclient",
            "fs",
            "sql"
        ],
        "owner": "snmp_parser"
    }
}
